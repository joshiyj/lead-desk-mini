# === MongoDB ===
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/leaddesk?retryWrites=true&w=majority

# === JWT ===
JWT_SECRET=replace_with_a_long_random_secret

# === Admin credentials (never store plaintext password here) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# === Server ===
PORT=5000
